# Copy to .env and fill in ONE key. With no key the app runs in offline mode.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LLM_PROVIDER=claude        # claude | gemini | offline
# CLAUDE_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=minimal    # minimal (fastest, default) | low | medium | high | default
# LLM_TIMEOUT=25            # seconds to wait for the model before using the offline parser
