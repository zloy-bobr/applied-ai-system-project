flowchart TD
    User["👤 User<br/>plain-English request"] --> UI["📱 Streamlit app.py / CLI src/main.py"]
    UI --> Agent

    subgraph Agent["🤖 RecommendationAgent (src/ai/agent.py)"]
        direction TB
        G["1 · GUARD<br/>empty / too long / injection<br/>(guardrails.py)"]
        P["2 · PLAN<br/>request → taste profile<br/>LLM, retry once, else offline parser"]
        V["3 · VALIDATE<br/>map labels to catalog, clamp numbers,<br/>drop invented fields (guardrails.py)"]
        S["4 · SCORE & RANK<br/>Module 3 score_song / recommend_songs"]
        C["5 · SELF-CHECK<br/>confidence, artist variety,<br/>missing-genre warnings · refine once"]
        E["6 · EXPLAIN<br/>LLM writes reasons from scoring facts,<br/>hallucinated titles dropped"]
        G --> P --> V --> S --> C --> E
        G -. blocked .-> Out
        V -. no usable prefs .-> Clarify["🤔 Ask user to clarify"]
    end

    LLM["🧠 LLM provider (Strategy)<br/>Claude · Gemini · offline"] <--> P
    LLM <--> E
    Vocab["📚 Catalog vocabulary<br/>genres, moods, tags (catalog.py)"] --> P
    Vocab --> V
    Songs[("🎶 data/songs.csv<br/>18 songs")] --> Vocab
    Songs --> S

    E --> Out["🎵 Top 5 + confidence + explanations<br/>+ warnings + step trace"]
    Out --> UI
    Agent --> Log[("📝 logs/agent_runs.jsonl")]

    subgraph Eval["✅ Evaluation (src/evaluation/)"]
        Cases[("data/eval_cases.json<br/>15 labeled + 9 edge cases")] --> Harness["run_eval.py"]
        Harness --> Metrics["Hit@1 · Recall@5 · NDCG@5<br/>vs popularity baseline"]
        Harness --> Bias["Bias check: coverage,<br/>genre exposure, popularity"]
        Harness --> Rel["Reliability: guardrails,<br/>consistency"]
    end
    Harness --> Agent
    Tests["🧪 pytest (53 tests, fake LLM)"] --> Agent

    classDef ai fill:#4CAF50,stroke:#2E7D32,color:#fff
    classDef data fill:#FF9800,stroke:#E65100,color:#fff
    classDef eval fill:#9C27B0,stroke:#6A1B9A,color:#fff
    class P,E,LLM ai
    class Songs,Vocab,Cases,Log data
    class Harness,Metrics,Bias,Rel,Tests eval
